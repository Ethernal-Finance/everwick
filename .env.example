PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3100
DATABASE_PATH=./data/everwick.sqlite
NODE_ENV=development
# Local development enables citizenship preview automatically. Set 0 to require Stripe locally.
ALLOW_DEMO_CITIZENSHIP=1
TICK_MS=15000
ADMIN_EMAIL=
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER=price_1UDTVDDJYwhXS7aV6sGIBvwk
STRIPE_PRICE_BREEDER=price_1UDTVDDJYwhXS7aVSJoVT3DE
# CITIZEN aliases FOUNDER (same $25 / 1 slot); keep for older checkouts
STRIPE_PRICE_CITIZEN=price_1UDTVDDJYwhXS7aV6sGIBvwk
STRIPE_PRICE_TOWN=price_1UDTVEDJYwhXS7aVcDlQ4wad
STRIPE_PRICE_CITY=price_1UDTVFDJYwhXS7aVPdDAQH2Z
STRIPE_PRICE_PATRON=price_1UDTVGDJYwhXS7aVtHqe6kHD
AI_PROVIDER=local
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=
AI_MODEL=auto
AI_DAILY_CALL_LIMIT=10000
AI_TIMEOUT_MS=90000
AI_MAX_CONCURRENT=2
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
PUBLIC_CONTACT_EMAIL=

# Production Docker deployment
DOMAIN=
TRUST_PROXY=0

AI_RUNTIME=lmstudio

# Simulation days per year (1-365); keep fixed for an existing world. Default: adulthood in 324 minutes.
AGING_DAYS_PER_YEAR=3
